+int MainWindow::appIdForNxmUrl(const std::string& url)
+{
+  const std::string prefix = "nxm://";
+  if(!url.starts_with(prefix))
+    return -1;
+  const auto end = url.find('/', prefix.size());
+  const QString domain =
+    QString::fromStdString(
+      url.substr(prefix.size(), end == std::string::npos ? end : end - prefix.size()))
+      .toLower();
+  const QString path = QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) +
+                       "/limo-sync/nxm-domains.json";
+  QFile file(path);
+  if(!file.open(QIODevice::ReadOnly))
+  {
+    Log::debug("No nxm domain map at \"" + path.toStdString() + "\".");
+    return -1;
+  }
+  QJsonParseError parse_error;
+  const QJsonDocument doc = QJsonDocument::fromJson(file.readAll(), &parse_error);
+  if(parse_error.error != QJsonParseError::NoError || !doc.isObject())
+  {
+    Log::warning("Malformed nxm domain map at \"" + path.toStdString() + "\".");
+    return -1;
+  }
+  const QJsonValue value = doc.object().value(domain);
+  if(!value.isString())
+  {
+    Log::warning("No app mapped to nxm domain \"" + domain.toStdString() + "\".");
+    return -1;
+  }
+  const QString name = value.toString();
+  int found = -1;
+  int matches = 0;
+  for(int i = 0; i < ui->app_selection_box->count(); i++)
+  {
+    if(ui->app_selection_box->itemText(i) == name)
+    {
+      found = i;
+      matches++;
+    }
+  }
+  if(matches != 1)
+  {
+    Log::warning("Found " + std::to_string(matches) + " apps named \"" + name.toStdString() +
+                 "\" for nxm domain \"" + domain.toStdString() + "\".");
+    return -1;
+  }
+  Log::debug("Routing nxm domain \"" + domain.toStdString() + "\" to app \"" +
+             name.toStdString() + "\".");
+  return found;
+}
+
+void MainWindow::enqueueNxmDownload(const std::string& url)
+{
+  const int target = appIdForNxmUrl(url);
+  // Switching apps while an import is queued, an install dialog is open or a
+  // previous switch is still loading would let the dialog and installer read
+  // the deployer lists of one app and the app id of another, so wait.
+  const bool busy = nxm_pending_ || !mod_import_queue_.empty() || add_mod_dialog_->isVisible();
+  if(target >= 0 && target != currentApp())
+  {
+    if(busy)
+    {
+      Log::debug("Delaying download request until the current import is done.");
+      QTimer::singleShot(1000, this, [this, url]() { enqueueNxmDownload(url); });
+      return;
+    }
+    nxm_pending_ = true;
+    nxm_pending_url_ = url;
+    nxm_pending_app_ = ui->app_selection_box->itemText(target).toStdString();
+    ui->app_selection_box->setCurrentIndex(target);
+    return;
+  }
+  if(nxm_pending_)
+  {
+    QTimer::singleShot(1000, this, [this, url]() { enqueueNxmDownload(url); });
+    return;
+  }
+  if(target < 0)
+    Log::warning("Using the selected app for download request \"" + url + "\".");
+  ImportModInfo info;
+  info.app_id = currentApp();
+  info.action_type = ImportModInfo::download;
+  info.remote_request_url = url;
+  mod_import_queue_.push(info);
+  if(mod_import_queue_.size() == 1)
+    importMod();
+}
