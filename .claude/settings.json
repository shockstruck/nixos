{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "AskUserQuestion",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(jq *)",
      "Bash(just lint *)",
      "Bash(nix flake metadata *)",
      "Bash(nix flake show *)",
      "Bash(nix fmt *)",
      "Bash(nix-instantiate --parse *)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Skill",
      "Task",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "deny": [
      "Bash(disko *)",
      "Bash(flux *)",
      "Bash(helm *)",
      "Bash(home-manager *)",
      "Bash(just check *)",
      "Bash(just dev *)",
      "Bash(just run *)",
      "Bash(just update *)",
      "Bash(kubectl *)",
      "Bash(nix build *)",
      "Bash(nix develop *)",
      "Bash(nix flake check *)",
      "Bash(nix flake update *)",
      "Bash(nix profile *)",
      "Bash(nix repl *)",
      "Bash(nix run *)",
      "Bash(nix shell *)",
      "Bash(nixos-install *)",
      "Bash(nixos-rebuild *)",
      "Bash(sops *)",
      "Bash(talosctl *)",
      "CronCreate",
      "Monitor",
      "Read(./**/*.agekey)",
      "Read(./**/*.env)",
      "Read(./**/*.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.tfvars)",
      "Read(./**/kubeconfig)",
      "Read(./**/talosconfig)",
      "Read(./**/terraform.tfstate*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.mcp.json)",
      "Read(./.private/**)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/sops/age/**)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)",
      "RemoteTrigger",
      "ScheduleWakeup"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash.sh\"; s=$?; [ \"$s\" -eq 0 ] || [ \"$s\" -eq 2 ] || { echo \"[hook] hook exited $s (missing interpreter or crash); refusing to allow the call. Allowed next step: report the hook failure for reviewed repair and continue independent work; retry only after repair.\" >&2; exit 2; }; exit \"$s\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-nix-realise.sh\"; s=$?; [ \"$s\" -eq 0 ] || [ \"$s\" -eq 2 ] || { echo \"[hook] hook exited $s (missing interpreter or crash); refusing to allow the call. Allowed next step: report the hook failure for reviewed repair and continue independent work; retry only after repair.\" >&2; exit 2; }; exit \"$s\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-config-commentary.sh\"; s=$?; [ \"$s\" -eq 0 ] || [ \"$s\" -eq 2 ] || { echo \"[hook] hook exited $s (missing interpreter or crash); refusing to allow the call. Allowed next step: report the hook failure for reviewed repair and continue independent work; retry only after repair.\" >&2; exit 2; }; exit \"$s\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_CRON": "1"
  }
}
