diff --git a/ii/scripts/colors/random_konachan_wall.sh b/ii/scripts/colors/random_konachan_wall.sh
--- a/ii/scripts/colors/random_konachan_wall.sh
+++ b/ii/scripts/colors/random_konachan_wall.sh
@@ -30,13 +30,24 @@ SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 mkdir -p "$PICTURES_DIR/Wallpapers"
-page=$((1 + RANDOM % 1000));
-response=$(curl "https://konachan.net/post.json?tags=rating%3Asafe&limit=1&page=$page")
-link=$(echo "$response" | jq '.[0].file_url' -r);
-ext=$(echo "$link" | awk -F. '{print $NF}')
-downloadPath="$PICTURES_DIR/Wallpapers/konachan_random_image.$ext"
+response=$(curl --fail --silent --show-error \
+    "https://wallhaven.cc/api/v1/search?categories=101&purity=100&sorting=random&atleast=1920x1080") || exit 1
+link=$(jq -er '.data[0].path' <<< "$response") || {
+    notify-send "Wallpaper switcher" "Wallhaven returned no matching wallpapers" -a "Wallpaper switcher"
+    exit 1
+}
+wallpaperId=$(jq -er '.data[0].id' <<< "$response") || exit 1
+ext="${link##*.}"
+downloadPath="$PICTURES_DIR/Wallpapers/wallhaven_$wallpaperId.$ext"
 illogicalImpulseConfigPath="$HOME/.config/illogical-impulse/config.json"
-currentWallpaperPath=$(jq -r '.background.wallpaperPath' $illogicalImpulseConfigPath)
-if [ "$downloadPath" == "$currentWallpaperPath" ]; then
-    downloadPath="$PICTURES_DIR/Wallpapers/konachan_random_image-1.$ext"
-fi
-curl "$link" -o "$downloadPath"
+
+if ! curl --fail --location --silent --show-error "$link" --output "$downloadPath"; then
+    notify-send "Wallpaper switcher" "Failed to download the Wallhaven wallpaper" -a "Wallpaper switcher"
+    exit 1
+fi
+
+if [[ ! -s "$downloadPath" ]]; then
+    notify-send "Wallpaper switcher" "Wallhaven downloaded an empty wallpaper" -a "Wallpaper switcher"
+    rm -f "$downloadPath"
+    exit 1
+fi
+
 "$SCRIPT_DIR/switchwall.sh" --image "$downloadPath"
