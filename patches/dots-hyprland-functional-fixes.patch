diff --git a/ii/modules/sidebarRight/quickToggles/NetBird.qml b/ii/modules/sidebarRight/quickToggles/NetBird.qml
new file mode 100644
--- /dev/null
+++ b/ii/modules/sidebarRight/quickToggles/NetBird.qml
@@ -0,0 +1,57 @@
+import qs
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+QuickToggleButton {
+    id: root
+    buttonIcon: "vpn_lock"
+    toggled: false
+
+    onClicked: {
+        toggleProc.command = ["netbird", root.toggled ? "down" : "up"]
+        toggleProc.running = true
+    }
+
+    altAction: () => {
+        Quickshell.execDetached(["netbird-ui"])
+        GlobalStates.sidebarRightOpen = false
+    }
+
+    Process {
+        id: toggleProc
+        onExited: (exitCode, exitStatus) => {
+            statusProc.running = true
+            if (exitCode !== 0) {
+                Quickshell.execDetached([
+                    "notify-send",
+                    "NetBird",
+                    "Connection change failed; right-click the toggle to configure NetBird.",
+                    "-a", "Shell"
+                ])
+            }
+        }
+    }
+
+    Process {
+        id: statusProc
+        running: true
+        command: ["bash", "-c", "netbird status 2>/dev/null | grep -q 'Management: Connected'"]
+        onExited: (exitCode, exitStatus) => root.toggled = exitCode === 0
+    }
+
+    Timer {
+        interval: 5000
+        repeat: true
+        running: true
+        onTriggered: {
+            if (!statusProc.running && !toggleProc.running) statusProc.running = true
+        }
+    }
+
+    StyledToolTip {
+        content: "NetBird | Right-click to configure"
+    }
+}
